@using System.Globalization
@implements IDisposable
@inject ServicioRecordatorios Recordatorios
@inject ServicioVoz Voz
@inject ServicioPermisos PermisosApp
@inject EstadoApp Estado

@if (Pendiente is null)
{
    <section class="pantalla principal">
        <header class="cabecera">
            <h1 class="logo logo-chico">Suelta<span class="punto">.</span></h1>
            <span class="fecha">@FormatoFechas.Cabecera(_ahora)</span>
        </header>

        @if (!_cargado)
        {
            <div class="vacio"></div>
        }
        else if (_todos.Count == 0)
        {
            <div class="vacio">
                <h2 class="titulo-grande">Tu cabeza<br />está libre.</h2>

                <BotonMicrofono Clase="mic-grande" Escuchando="_escuchando"
                                OnToque="AlTocarMicrofonoAsync" OnMantener="AlMantenerMicrofonoAsync" OnSoltar="AlSoltarMicrofonoAsync" />
                <p class="ayuda-mic">Mantén apretado y habla</p>

                <button type="button" class="ejemplo" @onclick="ProbarEjemplo">
                    <span class="ejemplo-rotulo">Prueba diciendo</span>
                    <span class="ejemplo-frase">“@Ejemplo”</span>
                </button>
            </div>
        }
        else
        {
            <nav class="pestanas" role="tablist">
                <button type="button" role="tab" aria-selected="@(_vista == Vista.Proximos)"
                        class="pestana @(_vista == Vista.Proximos ? "activa" : "")" @onclick="VerProximos">Próximos</button>
                <button type="button" role="tab" aria-selected="@(_vista == Vista.PorCategoria)"
                        class="pestana @(_vista == Vista.PorCategoria ? "activa" : "")" @onclick="VerPorCategoria">Por categoría</button>
            </nav>

            @if (_vista == Vista.Proximos)
            {
                @if (!_resumen.EstaVacio)
                {
                    <div class="pildoras">
                        @if (_resumen.Hoy > 0)
                        {
                            <span class="pildora"><b>@_resumen.Hoy</b> hoy</span>
                        }
                        @if (_resumen.ProximosSieteDias > 0)
                        {
                            <span class="pildora"><b>@_resumen.ProximosSieteDias</b> en los próximos 7 días</span>
                        }
                        @if (_resumen.SeRepitenSolos > 0)
                        {
                            <span class="pildora"><b>@_resumen.SeRepitenSolos</b> se repiten solos</span>
                        }
                    </div>
                }

                <div class="lista">
                    @foreach (var grupo in _grupos)
                    {
                        <h2 class="grupo-titulo">@grupo.Titulo</h2>
                        @foreach (var recordatorio in grupo.Items)
                        {
                            <TarjetaRecordatorio @key="recordatorio.Id" Recordatorio="recordatorio" Ahora="_ahora"
                                                 OnHecho="AlternarHechoAsync" OnEditar="Editar" OnEliminar="PedirEliminar" />
                        }
                    }
                </div>
            }
            else
            {
                <div class="categorias">
                    @foreach (var c in _conteos)
                    {
                        <button type="button" class="chip-cat @(_filtro == c.Info.Categoria ? "seleccionada" : "")"
                                style="--cat:@c.Info.Color" @onclick="() => FiltrarCategoria(c.Info.Categoria)">
                            <span class="chip-cat-icono" style="background:@c.Info.Color">@c.Info.Icono</span>
                            @c.Info.Nombre <b>@c.Cantidad</b>
                        </button>
                    }
                </div>

                <div class="lista">
                    @foreach (var c in _conteos.Where(c => _filtro is null || _filtro == c.Info.Categoria))
                    {
                        <h2 class="grupo-titulo" style="color:@c.Info.Color">@c.Info.Icono @c.Info.Nombre @c.Cantidad</h2>
                        @foreach (var recordatorio in AgrupadorCategorias.Filtrar(_todos, c.Info.Categoria))
                        {
                            <TarjetaRecordatorio @key="recordatorio.Id" Recordatorio="recordatorio" Ahora="_ahora"
                                                 OnHecho="AlternarHechoAsync" OnEditar="Editar" OnEliminar="PedirEliminar" />
                        }
                    }
                </div>
            }

            <div class="mic-flotante">
                <BotonMicrofono Escuchando="_escuchando"
                                OnToque="AlTocarMicrofonoAsync" OnMantener="AlMantenerMicrofonoAsync" OnSoltar="AlSoltarMicrofonoAsync" />
                <p class="ayuda-mic">Mantén apretado y habla</p>
            </div>
        }
    </section>
}
else
{
    var pendiente = Pendiente;
    var info = CategoriaInfo.De(pendiente.Categoria);
    var repeticion = FormatoFechas.EtiquetaRepeticion(new Recordatorio { Repeticion = pendiente.Repeticion });
    var faltaDia = pendiente.Faltan.Contains(DatoFaltante.Dia);
    var primeroFalta = pendiente.Faltan[0];

    <section class="pantalla pregunta">
        <p class="logo logo-chico">Suelta<span class="punto">.</span></p>

        <p class="rotulo">Dijiste</p>
        <p class="burbuja">“@pendiente.Dijiste”</p>
        <p class="entendi"><span>Entendí esto</span></p>

        <div class="tarjeta tarjeta-entendida">
            <span class="tarjeta-icono" style="background:@info.Color">@info.Icono</span>
            <div class="tarjeta-cuerpo">
                <strong class="tarjeta-titulo">@(pendiente.Titulo.Length > 0 ? pendiente.Titulo : "…")</strong>
                <span class="chips">
                    @if (repeticion.Length > 0)
                    {
                        <span class="chip chip-dato" style="color:@info.Color">@repeticion</span>
                    }
                    @if (faltaDia)
                    {
                        <span class="chip chip-falta">Falta el día</span>
                    }
                </span>
            </div>
        </div>

        <h2 class="pregunta-texto">@pendiente.Pregunta</h2>

        @if (pendiente.Opciones is { Count: > 0 } && !_modoOtro)
        {
            <div class="opciones">
                @foreach (var opcion in pendiente.Opciones)
                {
                    <button type="button" class="opcion" @onclick="() => ElegirOpcionAsync(opcion)">@opcion.Etiqueta</button>
                }
            </div>
        }

        <BotonMicrofono Clase="mic-grande" Escuchando="_escuchando"
                        OnToque="AlTocarMicrofonoAsync" OnMantener="AlMantenerMicrofonoAsync" OnSoltar="AlSoltarMicrofonoAsync" />
        <p class="ayuda-mic">@(_escuchando ? "Te escucho..." : "Dilo con tu voz")</p>

        @if (_mensaje is not null && !_hojaAbierta)
        {
            <p class="mensaje">@_mensaje</p>
        }

        @if (primeroFalta == DatoFaltante.Dia)
        {
            <label class="boton-calendario">
                <span>@((MarkupString)Iconos.Calendario) Elegir en el calendario</span>
                <input type="date" min="@HoyIso" @onchange="AlElegirFechaAsync" />
            </label>
        }

        <button type="button" class="boton-texto" @onclick="CancelarPregunta">Cancelar</button>
    </section>
}

@if (_hojaAbierta)
{
    <div class="hoja-fondo" @onclick="CerrarHoja"></div>
    <div class="hoja" role="dialog" aria-label="Crear recordatorio">
        <div class="hoja-cabecera">
            <span class="mic-mini @(_escuchando ? "escuchando" : "")">@((MarkupString)Iconos.Microfono)</span>
            <div class="hoja-textos">
                <strong>@(_escuchando ? "Te escucho..." : Pendiente is null ? "Escribe tu recordatorio" : Pendiente.Pregunta)</strong>
                <small>Dilo como te salga. Aquí puedes usar el micrófono de tu teclado o escribir.</small>
            </div>
            @if (_escuchando)
            {
                <span class="onda" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            }
        </div>

        <textarea @ref="_campo" class="campo" rows="3" placeholder="Ej: mañana pagar el recibo a las 5"
                  @bind="_texto" @bind:event="oninput"></textarea>

        @if (_mensaje is not null)
        {
            <p class="mensaje">@_mensaje</p>
        }

        <div class="hoja-pie">
            <button type="button" class="boton-secundario" @onclick="CerrarHoja">Cancelar</button>
            <button type="button" class="boton-primario" disabled="@(_texto.Trim().Length == 0 || _guardando)" @onclick="GuardarDesdeHojaAsync">Guardar</button>
        </div>
    </div>
}

@if (_editando is not null)
{
    <EditarRecordatorio Recordatorio="_editando" OnGuardar="GuardarEdicionAsync" OnCancelar="CancelarEdicion" />
}

@if (_porEliminar is not null)
{
    <div class="hoja-fondo" @onclick="CancelarEliminar"></div>
    <div class="dialogo" role="alertdialog">
        <p>¿Eliminar este recordatorio?</p>
        <p class="dialogo-detalle">@_porEliminar.Titulo</p>
        <div class="hoja-pie">
            <button type="button" class="boton-secundario" @onclick="CancelarEliminar">Cancelar</button>
            <button type="button" class="boton-peligro" @onclick="ConfirmarEliminarAsync">Eliminar</button>
        </div>
    </div>
}

@if (_avisoAjustes)
{
    <div class="hoja-fondo" @onclick="CerrarAvisoAjustes"></div>
    <div class="dialogo" role="alertdialog">
        <p>Activa los avisos para que Suelta te recuerde</p>
        <div class="hoja-pie">
            <button type="button" class="boton-secundario" @onclick="CerrarAvisoAjustes">Ahora no</button>
            <button type="button" class="boton-primario" @onclick="AbrirAjustes">Abrir ajustes</button>
        </div>
    </div>
}

@if (_toast is not null)
{
    <div class="toast" role="status">
        <span>@_toast</span>
        @if (_toastConDeshacer)
        {
            <button type="button" class="toast-accion" @onclick="DeshacerAsync">Deshacer</button>
        }
    </div>
}

@code {
    private enum Vista { Proximos, PorCategoria }

    private const string Ejemplo = "El 5 de noviembre es el cumpleaños de Martín";

    private List<Recordatorio> _todos = [];
    private List<GrupoRecordatorios> _grupos = [];
    private IReadOnlyList<ConteoCategoria> _conteos = [];
    private ResumenCarga _resumen = new(0, 0, 0);
    private DateTime _ahora = ZonaLima.Ahora();
    private bool _cargado;
    private Vista _vista = Vista.Proximos;
    private Categoria? _filtro;

    private bool _hojaAbierta;
    private bool _enfocarCampo;
    private bool _escuchando;
    private bool _guardando;
    private bool _avisoAjustes;
    private string _texto = "";
    private string? _mensaje;
    private ElementReference _campo;

    private string? _toast;
    private bool _toastConDeshacer;
    private int _toastId;
    private List<Recordatorio> _ultimosGuardados = [];

    private Recordatorio? _editando;
    private Recordatorio? _porEliminar;

    // Lo que se entendió de la frase: puede ser más de un recordatorio (HU-08). Mientras
    // a alguno le falte un dato se pregunta, y recién cuando están todos completos se guarda.
    private List<ResultadoParser> _lote = [];
    private bool _modoOtro;

    private ResultadoParser? Pendiente => _lote.FirstOrDefault(r => !r.Completo);

    private static string HoyIso => ZonaLima.Ahora().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        Voz.TextoParcial += AlLlegarTextoParcial;
        await RecargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enfocarCampo && _hojaAbierta)
        {
            _enfocarCampo = false;
            await _campo.FocusAsync();
        }
    }

    private async Task RecargarAsync()
    {
        _ahora = ZonaLima.Ahora();
        _todos = await Recordatorios.ListarAsync();
        _grupos = AgrupadorLista.Agrupar(_todos, _ahora).ToList();
        _conteos = AgrupadorCategorias.Contar(_todos);
        _resumen = ResumenCarga.De(_todos, _ahora);

        if (_filtro is not null && _conteos.All(c => c.Info.Categoria != _filtro))
            _filtro = null;

        _cargado = true;
    }

    // ---- pestañas y filtros ----

    private void VerProximos()
    {
        _vista = Vista.Proximos;
        _filtro = null;
    }

    private void VerPorCategoria() => _vista = Vista.PorCategoria;

    private void FiltrarCategoria(Categoria categoria) => _filtro = _filtro == categoria ? null : categoria;

    // ---- botón del micrófono ----

    /// <summary>Toque corto: se abre la hoja con el campo de texto y el teclado (HU-06).</summary>
    private async Task AlTocarMicrofonoAsync()
    {
        if (await MostrarAvisoAjustesSiCorrespondeAsync()) return;

        _mensaje = null;
        _texto = "";
        AbrirHojaParaEscribir();
    }

    /// <summary>Mantener apretado: se escucha mientras dure (HU-04).</summary>
    private async Task AlMantenerMicrofonoAsync()
    {
        if (await MostrarAvisoAjustesSiCorrespondeAsync()) return;

        _mensaje = null;

        if (!await PermisosApp.MicrofonoConcedidoAsync())
        {
            // Sin permiso del micrófono se puede escribir la frase.
            _texto = "";
            _mensaje = "Sin el micrófono, escribe tu frase.";
            AbrirHojaParaEscribir();
            return;
        }

        if (Pendiente is null)
        {
            _texto = "";
            _hojaAbierta = true;
        }

        _escuchando = true;
        StateHasChanged();

        if (!await Voz.IniciarAsync())
        {
            _escuchando = false;
            _mensaje = "No pude escuchar. Escribe tu frase.";
            AbrirHojaParaEscribir();
        }
    }

    private async Task AlSoltarMicrofonoAsync()
    {
        if (!_escuchando) return;

        var texto = await Voz.DetenerAsync();
        _escuchando = false;

        if (texto.Length == 0)
        {
            _texto = "";
            _mensaje = "No te escuché, intenta otra vez";
            return;
        }

        _mensaje = null;

        if (Pendiente is not null)
        {
            // Respondiendo la pregunta: con la voz se completa y se guarda de una vez.
            Responder(texto);
            await ProcesarAsync();
            return;
        }

        // Frase nueva: aparece escrita para revisarla y corregirla antes de guardar (HU-05).
        _texto = texto;
    }

    private void AlLlegarTextoParcial(string texto) => InvokeAsync(() =>
    {
        if (_escuchando && Pendiente is null)
        {
            _texto = texto;
            StateHasChanged();
        }
    });

    private void AbrirHojaParaEscribir()
    {
        _hojaAbierta = true;
        _enfocarCampo = true;
    }

    private void ProbarEjemplo()
    {
        _mensaje = null;
        _texto = Ejemplo;
        _hojaAbierta = true;
    }

    private void CerrarHoja()
    {
        _hojaAbierta = false;
        _texto = "";
        _mensaje = null;
    }

    // ---- guardar y preguntar ----

    private async Task GuardarDesdeHojaAsync()
    {
        var texto = _texto.Trim();
        if (texto.Length == 0 || _guardando) return;

        _guardando = true;
        try
        {
            _mensaje = null;

            if (_lote.Count == 0)
                _lote = ParserLocal.InterpretarVarios(texto, ZonaLima.Ahora()).ToList();
            else
                Responder(texto);

            await ProcesarAsync();
        }
        finally
        {
            _guardando = false;
        }
    }

    // La respuesta completa el recordatorio al que le faltaba un dato.
    private void Responder(string respuesta)
    {
        var indice = _lote.FindIndex(r => !r.Completo);
        if (indice < 0) return;

        _lote[indice] = ParserLocal.Completar(_lote[indice], respuesta, ZonaLima.Ahora());
        _modoOtro = false;
    }

    private async Task ElegirOpcionAsync(OpcionAclaracion opcion)
    {
        var indice = _lote.FindIndex(r => !r.Completo);
        if (indice < 0) return;

        if (opcion.EsOtro)
        {
            // "Otro": se dice o se escribe qué recordar.
            _modoOtro = true;
            return;
        }

        _lote[indice] = ParserLocal.ConOpcion(_lote[indice], opcion, ZonaLima.Ahora());
        await ProcesarAsync();
    }

    private async Task AlElegirFechaAsync(ChangeEventArgs e)
    {
        var indice = _lote.FindIndex(r => !r.Completo);
        if (indice < 0) return;

        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return;

        _lote[indice] = ParserLocal.ConFecha(_lote[indice], fecha);
        await ProcesarAsync();
    }

    private async Task ProcesarAsync()
    {
        _hojaAbierta = false;
        _texto = "";
        _mensaje = null;

        // Si todavía falta algo, se muestra la pregunta; el recordatorio todavía no se guarda.
        if (_lote.Count == 0 || Pendiente is not null) return;

        _ultimosGuardados = (await Recordatorios.GuardarVariosAsync(_lote, ZonaLima.Ahora())).ToList();
        _lote = [];
        _modoOtro = false;

        await RecargarAsync();
        _ = MostrarToastAsync("Guardado. Ya no tienes que acordarte", conDeshacer: true);
    }

    private void CancelarPregunta()
    {
        _lote = [];
        _modoOtro = false;
        _texto = "";
        _mensaje = null;
    }

    // ---- hecho, editar, eliminar y deshacer ----

    private async Task AlternarHechoAsync(Recordatorio r)
    {
        var ahora = ZonaLima.Ahora();
        if (r.Hecho)
            await Recordatorios.DesmarcarHechoAsync(r, ahora);
        else
            await Recordatorios.MarcarHechoAsync(r, ahora);

        await RecargarAsync();
    }

    private void Editar(Recordatorio r) => _editando = r;

    private void CancelarEdicion() => _editando = null;

    private async Task GuardarEdicionAsync(Recordatorio r)
    {
        await Recordatorios.ActualizarAsync(r, ZonaLima.Ahora());
        _editando = null;

        await RecargarAsync();
        _ = MostrarToastAsync("Recordatorio actualizado correctamente");
    }

    private void PedirEliminar(Recordatorio r) => _porEliminar = r;

    private void CancelarEliminar() => _porEliminar = null;

    private async Task ConfirmarEliminarAsync()
    {
        if (_porEliminar is null) return;

        await Recordatorios.EliminarAsync([_porEliminar], ZonaLima.Ahora());
        _porEliminar = null;

        await RecargarAsync();
        _ = MostrarToastAsync("Recordatorio eliminado correctamente");
    }

    /// <summary>Deshacer quita todos los recordatorios que se guardaron juntos (HU-24).</summary>
    private async Task DeshacerAsync()
    {
        _toastId++;
        _toast = null;

        await Recordatorios.EliminarAsync(_ultimosGuardados, ZonaLima.Ahora());
        _ultimosGuardados = [];

        await RecargarAsync();
    }

    private async Task MostrarToastAsync(string mensaje, bool conDeshacer = false)
    {
        var id = ++_toastId;
        _toast = mensaje;
        _toastConDeshacer = conDeshacer;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(conDeshacer ? 5000 : 3000);

        // Si apareció otro mensaje mientras tanto, ese se encarga de sí mismo.
        if (id != _toastId) return;
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    // ---- aviso de notificaciones (HU-02) ----

    /// <summary>Si faltan los avisos, la primera vez que se toca el micrófono se explica por qué activarlos.</summary>
    private async Task<bool> MostrarAvisoAjustesSiCorrespondeAsync()
    {
        if (Estado.AvisoAjustesYaMostrado || await PermisosApp.AvisosConcedidosAsync()) return false;

        Estado.AvisoAjustesYaMostrado = true;
        _avisoAjustes = true;
        return true;
    }

    private void CerrarAvisoAjustes() => _avisoAjustes = false;

    private void AbrirAjustes()
    {
        _avisoAjustes = false;
        PermisosApp.AbrirAjustes();
    }

    public void Dispose() => Voz.TextoParcial -= AlLlegarTextoParcial;
}
