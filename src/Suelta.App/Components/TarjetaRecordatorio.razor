@{
    var info = CategoriaInfo.De(Recordatorio.Categoria);
    var repeticion = FormatoFechas.EtiquetaRepeticion(Recordatorio);
    var aviso = FormatoFechas.AvisoAnticipado(Recordatorio);
}

<article id="r-@Recordatorio.Id"
         class="fila @(_abierta ? "abierta" : "") @(Recordatorio.Hecho ? "hecha" : "") @(_saliendo ? "sale" : "")"
         @onclick="Alternar">
    <div class="fila-principal">
        <span class="icono-tema" style="background:@info.Color">@((MarkupString)Iconos.Svg(info.Icono, 22))</span>

        <div class="fila-texto">
            <b>@Recordatorio.Titulo</b>
            <span>
                @FormatoFechas.Cuando(Recordatorio, Ahora)
                @if (repeticion.Length > 0)
                {
                    <em style="color:@info.Color">@repeticion</em>
                }
            </span>
        </div>

        <button type="button"
                class="check @(Recordatorio.Hecho ? "marcado" : "")"
                aria-label="@(Recordatorio.Hecho ? "Devolver a próximos" : "Marcar como hecho")"
                @onclick="MarcarAsync"
                @onclick:stopPropagation="true">
            @((MarkupString)Iconos.Svg("check", 18))
        </button>
    </div>

    @if (_abierta)
    {
        <div class="fila-detalle">
            @if (Recordatorio.Dijiste.Length > 0)
            {
                <p><b>Dijiste:</b> “@Recordatorio.Dijiste”</p>
            }
            @if (aviso.Length > 0)
            {
                <p>@aviso</p>
            }
            <div class="fila-acciones">
                <button type="button" class="accion" @onclick="() => OnEditar.InvokeAsync(Recordatorio)" @onclick:stopPropagation="true">Editar</button>
                <button type="button" class="accion accion-peligro" @onclick="() => OnEliminar.InvokeAsync(Recordatorio)" @onclick:stopPropagation="true">Eliminar</button>
            </div>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public Recordatorio Recordatorio { get; set; } = default!;
    [Parameter, EditorRequired] public DateTime Ahora { get; set; }
    [Parameter] public EventCallback<Recordatorio> OnHecho { get; set; }
    [Parameter] public EventCallback<Recordatorio> OnEditar { get; set; }
    [Parameter] public EventCallback<Recordatorio> OnEliminar { get; set; }

    /// <summary>Se pide abrir la tarjeta, por ejemplo al tocar su notificación (HU-22).</summary>
    [Parameter] public bool Expandida { get; set; }

    private bool _abierta;
    private bool _saliendo;

    protected override void OnParametersSet()
    {
        if (Expandida) _abierta = true;
    }

    private void Alternar() => _abierta = !_abierta;

    // La tarjeta se desliza hacia afuera un instante antes de pasar a "Hechos" (o a su siguiente fecha).
    private async Task MarcarAsync()
    {
        if (!Recordatorio.Hecho)
        {
            _saliendo = true;
            await Task.Delay(260);
        }

        await OnHecho.InvokeAsync(Recordatorio);
        _saliendo = false;
    }
}
